"use client";
import { useMemo, useState } from "react";
import Link from "next/link";
import { useAccount, useReadContract, useWriteContract } from "wagmi";
import {
  ArrowRight,
  CheckCircle2,
  Clock3,
  Fingerprint,
  Loader2,
  OctagonAlert,
  RefreshCw,
  ShieldAlert,
  ShieldCheck,
  TimerReset,
  XCircle,
} from "lucide-react";
import { keccak256, concatHex, encodeAbiParameters } from "viem";
import Nav from "@/components/Nav";
import Background from "@/components/Background";
import SectionTitle from "@/components/SectionTitle";
import ConnectCard from "@/components/ConnectCard";
import OnChainPill from "@/components/OnChainPill";
import TxToast from "@/components/TxToast";
import {
  CONTRACTS,
  AUTH_CONFIG_MANAGER,
  IDENTITY_REGISTRY,
  shortAddress,
  schemeName,
} from "@/lib/anchor";
import {
  createPasskey,
  isWebAuthnAvailable,
  registrationChallenge,
  signWithPasskey,
  actionChallenge,
  credentialFor,
  saveCredential,
} from "@/lib/webauthn";
export default function Policy() {
  const { address, isConnected } = useAccount();
  const { data: s, refetch } = useReadContract({
    address: CONTRACTS.anchorViews.address,
    abi: CONTRACTS.anchorViews.abi,
    functionName: "getAccountSummary",
    args: address ? [address] : undefined,
    query: { enabled: !!address, refetchInterval: 5000 },
  });
  const { writeContractAsync } = useWriteContract();
  const [busy, setBusy] = useState(false);
  const [msg, setMsg] = useState("");
  const [tx, setTx] = useState<string>();
  const [xName, setXName] = useState("");
  const [registeredPasskeyId, setRegisteredPasskeyId] = useState("");
  const [candidateId, setCandidateId] = useState("");
  const [includeCandidate, setIncludeCandidate] = useState(false);
  const x = s as any;
  const candidateValid = /^0x[0-9a-fA-F]{64}$/.test(candidateId.trim());
  const { data: candidateIdentity, isFetching: candidateLoading } =
    useReadContract({
      address: IDENTITY_REGISTRY,
      abi: CONTRACTS.identityRegistry.abi,
      functionName: "getIdentity",
      args: candidateValid ? [candidateId.trim() as `0x${string}`] : undefined,
      query: { enabled: candidateValid },
    });
  const candidateRaw = candidateIdentity as any;
  const candidate =
    Array.isArray(candidateRaw) &&
    candidateRaw.length === 1 &&
    (Array.isArray(candidateRaw[0]) || typeof candidateRaw[0] === "object")
      ? candidateRaw[0]
      : candidateRaw;
  const candidateOwner = candidate?.owner ?? candidate?.[0];
  const candidateActive = candidate?.active ?? candidate?.[5];
  const candidateName = candidate?.displayName ?? candidate?.[3];
  const auths = (x?.authenticators || []) as any[];
  const activeAuths = auths.filter((a) => a.active);
  const [keep, setKeep] = useState<number[]>([]);
  const effectiveKeep = keep.length
    ? keep
    : activeAuths.map((a) => Number(a.id));
  const remaining = activeAuths.filter((a) =>
    effectiveKeep.includes(Number(a.id)),
  );
  const selectedProofAuth =
    remaining.find((a) => a.scheme === 1 && a.active) ||
    auths.find((a) => a.scheme === 1 && a.active);
  const [known, setKnown] = useState(true);
  const [credentialHint, setCredentialHint] = useState("");
  const pending = x?.hasPending;
  const stage = async () => {
    if (!address || !x || auths.length === 0) return;
    setBusy(true);
    setMsg("");
    try {
      if (!selectedProofAuth)
        throw new Error(
          "A passkey authenticator is required to propose this policy change.",
        );
      const credential = credentialFor(selectedProofAuth.identityId);
      if (!credential)
        throw new Error(
          `No browser credential is stored for ${shortAddress(selectedProofAuth.identityId)}. Register that passkey on this browser before proposing.`,
        );
      const nonce = BigInt(x.nextNonce ?? 0);
      const challenge = await actionChallenge(address, "propose", nonce);
      const proof = await signWithPasskey(credential, challenge);
      const newAuths = remaining.map((a) => ({
        id: Number(a.id),
        scheme: Number(a.scheme),
        identityId: a.identityId,
      }));
      if (includeCandidate) {
        if (
          !candidateValid ||
          !candidate ||
          !candidateActive ||
          String(candidateOwner).toLowerCase() !== address.toLowerCase()
        )
          throw new Error(
            "The selected identity must be active and owned by this connected wallet.",
          );
        if (
          auths.some(
            (a) =>
              String(a.identityId).toLowerCase() ===
              candidateId.trim().toLowerCase(),
          )
        )
          throw new Error("This identity is already configured.");
        const nextId =
          auths.reduce((max, a) => Math.max(max, Number(a.id)), 0) + 1;
        if (nextId > 255)
          throw new Error("No unused uint8 authenticator ID is available.");
        newAuths.push({
          id: nextId,
          scheme: 1,
          identityId: candidateId.trim() as `0x${string}`,
        });
      }
      const policy = newAuths.filter((a) => a.scheme === 1).map((a) => a.id);
      if (!policy.length)
        throw new Error(
          "At least one active passkey must remain in the policy.",
        );
      const signingThreshold = Math.min(
        Number(x.signingThreshold || 1),
        policy.length,
      );
      const reconfigPolicy = policy.slice();
      const reconfigThreshold = Math.min(
        Number(x.reconfigThreshold || 1),
        reconfigPolicy.length,
      );
      const requestData = encodeAbiParameters(
        [
          {
            type: "tuple",
            components: [
              { name: "account", type: "address" },
              {
                name: "config",
                type: "tuple",
                components: [
                  {
                    name: "authenticators",
                    type: "tuple[]",
                    components: [
                      { name: "id", type: "uint8" },
                      { name: "scheme", type: "uint8" },
                      { name: "identityId", type: "bytes32" },
                    ],
                  },
                  { name: "signingPolicy", type: "uint8[]" },
                  { name: "signingThreshold", type: "uint8" },
                  { name: "reconfigPolicy", type: "uint8[]" },
                  { name: "reconfigThreshold", type: "uint8" },
                  { name: "isKnownDevicePattern", type: "bool" },
                ],
              },
              {
                name: "proofs",
                type: "tuple[]",
                components: [
                  { name: "authenticatorId", type: "uint8" },
                  {
                    name: "proof",
                    type: "tuple",
                    components: [
                      { name: "authenticatorData", type: "bytes" },
                      { name: "clientDataJSONPrefix", type: "string" },
                      { name: "clientDataJSONSuffix", type: "string" },
                      { name: "sigR", type: "bytes32" },
                      { name: "sigS", type: "bytes32" },
                    ],
                  },
                ],
              },
            ],
          },
        ] as const,
        [
          {
            account: address,
            config: {
              authenticators: newAuths,
              signingPolicy: policy,
              signingThreshold,
              reconfigPolicy,
              reconfigThreshold,
              isKnownDevicePattern: known,
            },
            proofs: [{ authenticatorId: Number(selectedProofAuth.id), proof }],
          },
        ],
      );
      const hash = await writeContractAsync({
        address: AUTH_CONFIG_MANAGER,
        abi: CONTRACTS.authConfigManager.abi,
        functionName: "proposeReconfigurationWithPasskey",
        args: [requestData],
      });
      setTx(hash);
      setMsg(
        "Policy change proposed. The contract calculated the risk score and started the 24-hour reconfiguration window.",
      );
      await refetch();
    } catch (e) {
      setMsg(e instanceof Error ? e.message : "Proposal failed");
    } finally {
      setBusy(false);
    }
  };
  const contest = async () => {
    if (!address || !x?.hasPending || !selectedProofAuth) return;
    setBusy(true);
    try {
      const credential = credentialFor(selectedProofAuth.identityId);
      if (!credential)
        throw new Error(
          "The required passkey is not available in this browser.",
        );
      const ch = await actionChallenge(
        address,
        "contest",
        BigInt(x.nextNonce ?? 0),
      );
      const proof = await signWithPasskey(credential, ch);
      const hash = await writeContractAsync({
        address: AUTH_CONFIG_MANAGER,
        abi: CONTRACTS.authConfigManager.abi,
        functionName: "contestReconfigurationWithPasskey",
        args: [
          address,
          [{ authenticatorId: Number(selectedProofAuth.id), proof }],
        ],
      });
      setTx(hash);
      setMsg("Pending policy change contested on-chain.");
      await refetch();
    } catch (e) {
      setMsg(e instanceof Error ? e.message : "Contest failed");
    } finally {
      setBusy(false);
    }
  };
  const confirm = async () => {
    if (!address || !x?.hasPending || !selectedProofAuth) return;
    setBusy(true);
    try {
      const credential = credentialFor(selectedProofAuth.identityId);
      if (!credential)
        throw new Error(
          "The required passkey is not available in this browser.",
        );
      const ch = await actionChallenge(
        address,
        "confirm",
        BigInt(x.nextNonce ?? 0),
      );
      const proof = await signWithPasskey(credential, ch);
      const hash = await writeContractAsync({
        address: AUTH_CONFIG_MANAGER,
        abi: CONTRACTS.authConfigManager.abi,
        functionName: "confirmHighRiskProposalWithPasskey",
        args: [
          address,
          [{ authenticatorId: Number(selectedProofAuth.id), proof }],
        ],
      });
      setTx(hash);
      setMsg(
        "Extra confirmation recorded on-chain. The 24-hour delay still applies.",
      );
      await refetch();
    } catch (e) {
      setMsg(e instanceof Error ? e.message : "Confirmation failed");
    } finally {
      setBusy(false);
    }
  };
  const activate = async () => {
    if (!address) return;
    setBusy(true);
    try {
      const hash = await writeContractAsync({
        address: AUTH_CONFIG_MANAGER,
        abi: CONTRACTS.authConfigManager.abi,
        functionName: "activateReconfiguration",
        args: [address],
      });
      setTx(hash);
      setMsg("Reconfiguration activation submitted.");
      await refetch();
    } catch (e) {
      setMsg(e instanceof Error ? e.message : "Activation failed");
    } finally {
      setBusy(false);
    }
  };
  const addPasskey = async () => {
    if (!address || !isWebAuthnAvailable())
      return setMsg("WebAuthn is unavailable in this browser.");
    setBusy(true);
    try {
      const ch = await registrationChallenge(address);
      const created = await createPasskey(ch, address);
      const proof = await signWithPasskey(created.credentialId, ch);
      const hash = await writeContractAsync({
        address: IDENTITY_REGISTRY,
        abi: CONTRACTS.identityRegistry.abi,
        functionName: "registerWithPasskey",
        args: [
          created.pubKeyX,
          created.pubKeyY,
          proof,
          xName || "New Anchor Passkey",
        ],
      });
      const id = keccak256(concatHex([created.pubKeyX, created.pubKeyY]));
      saveCredential(id, created.credentialId);
      setRegisteredPasskeyId(id);
      setCandidateId(id);
      setIncludeCandidate(false);
      setTx(hash);
      setMsg(
        "Passkey registration submitted. Waiting for transaction confirmation before proposing a policy change.",
      );
      setXName("");
      await refetch();
    } catch (e) {
      setMsg(e instanceof Error ? e.message : "Passkey registration failed");
    } finally {
      setBusy(false);
    }
  };
  const pendingPct = useMemo(() => {
    if (!x?.hasPending) return 0;
    const start = Number(x.pendingProposedAt) * 1000;
    const end = start + 86400000;
    return Math.max(
      0,
      Math.min(100, ((Date.now() - start) / (end - start)) * 100),
    );
  }, [x?.hasPending, x?.pendingProposedAt]);
  if (!isConnected)
    return (
      <>
        <Background />
        <Nav />
        <main className="mx-auto max-w-7xl px-4 pb-24 pt-32 sm:px-6 lg:px-8">
          <SectionTitle
            eyebrow="Policy"
            title="Security rules should be changeable — never instantaneous."
            body="Anchor lets an authorized passkey propose a new policy, scores the change, delays activation, and gives the account a contest path."
          />
          <div className="mt-12">
            <ConnectCard />
          </div>
        </main>
      </>
    );
  return (
    <>
      <Background />
      <Nav />
      <main className="mx-auto max-w-7xl px-4 pb-24 pt-32 sm:px-6 lg:px-8">
        <SectionTitle
          eyebrow="Policy engine"
          title="Control who can act on the address."
          body="Select which authenticators survive the next policy version. Removing authenticators or weakening thresholds can become high risk and require extra confirmation."
        />
        <div className="mt-12 grid gap-5 lg:grid-cols-[1.25fr_.75fr]">
          <section className="glass rounded-3xl p-6 sm:p-8">
            <div className="flex items-start justify-between gap-4">
              <div>
                <p className="text-[10px] uppercase tracking-[.18em] text-mint">
                  Current authorization set
                </p>
                <h2 className="display mt-2 text-2xl font-semibold">
                  Authenticators
                </h2>
              </div>
              <OnChainPill text={`${auths.length} on-chain`} />
            </div>
            <div className="mt-6 space-y-2">
              {auths.map((a: any) => {
                const checked = effectiveKeep.includes(Number(a.id));
                return (
                  <button
                    key={a.id}
                    onClick={() =>
                      setKeep((v) =>
                        checked
                          ? v.filter((id) => id !== Number(a.id))
                          : [...v, Number(a.id)],
                      )
                    }
                    className={`focus-ring flex w-full items-center gap-4 rounded-2xl border p-4 text-left transition ${checked ? "border-mint/20 bg-mint/5" : "border-danger/20 bg-danger/5"}`}
                  >
                    <span
                      className={`grid h-10 w-10 shrink-0 place-items-center rounded-xl ${checked ? "bg-mint/10 text-mint" : "bg-danger/10 text-danger"}`}
                    >
                      {checked ? (
                        <CheckCircle2 size={18} />
                      ) : (
                        <XCircle size={18} />
                      )}
                    </span>
                    <span className="min-w-0 flex-1">
                      <span className="block text-sm font-medium">
                        {a.displayName || "Unnamed passkey"}
                      </span>
                      <span className="mono mt-1 block truncate text-[10px] text-muted">
                        #{a.id} · {schemeName(Number(a.scheme))} ·{" "}
                        {shortAddress(a.identityId)}
                      </span>
                    </span>
                    <span className="text-[10px] uppercase tracking-[.12em] text-muted">
                      {checked ? "Keep" : "Remove"}
                    </span>
                  </button>
                );
              })}
            </div>
            <div className="mt-7 rounded-2xl border border-white/8 bg-white/[.02] p-4">
              <div className="flex items-center gap-2 text-xs font-medium">
                <ShieldCheck size={15} className="text-mint" />
                Proposed result
              </div>
              <p className="mt-2 text-xs leading-5 text-muted">
                {remaining.length} authenticator
                {remaining.length === 1 ? "" : "s"} remain. Signing threshold:{" "}
                {Math.min(
                  Number(x?.signingThreshold || 1),
                  remaining.length || 1,
                )}
                . Reconfiguration threshold:{" "}
                {Math.min(
                  Number(x?.reconfigThreshold || 1),
                  remaining.length || 1,
                )}
                .
              </p>
            </div>
            <div className="mt-7 border-t border-white/5 pt-7">
              <p className="text-xs font-semibold">Need another device?</p>
              <div className="mt-3 flex gap-2">
                <input
                  value={xName}
                  onChange={(e) => setXName(e.target.value)}
                  placeholder="New passkey name"
                  className="min-w-0 flex-1 rounded-xl border border-white/10 bg-white/[.03] px-3 py-2.5 text-xs outline-none focus:border-mint/30"
                />
                <button
                  disabled={busy}
                  onClick={addPasskey}
                  className="inline-flex items-center gap-2 rounded-xl border border-mint/20 bg-mint/5 px-4 py-2.5 text-xs text-mint"
                >
                  {busy ? (
                    <Loader2 size={14} className="animate-spin" />
                  ) : (
                    <Fingerprint size={14} />
                  )}{" "}
                  Add
                </button>
              </div>
              <div className="mt-5 border-t border-white/5 pt-5">
                <p className="text-xs font-semibold">
                  anchor:include-registered-passkey — Include an already
                  registered passkey
                </p>
                <p className="mt-2 text-xs leading-5 text-muted">
                  Enter its bytes32 identity ID. Anchor checks ownership and
                  active status on-chain before proposing a policy change.
                </p>
                {registeredPasskeyId && (
                  <div className="mt-3 rounded-xl border border-mint/20 bg-mint/5 p-3">
                    <p className="text-xs font-semibold text-mint">
                      anchor:registered-passkey-id — New identity ID
                    </p>
                    <code className="mt-2 block break-all text-[10px] leading-5">
                      {registeredPasskeyId}
                    </code>
                    <button
                      type="button"
                      onClick={() => {
                        void navigator.clipboard
                          .writeText(registeredPasskeyId)
                          .then(() =>
                            setMsg(
                              "Identity ID copied. Wait for registration confirmation before staging a policy change.",
                            ),
                          )
                          .catch(() =>
                            setMsg(
                              "Copy failed. Select and copy the identity ID manually.",
                            ),
                          );
                      }}
                      className="mt-2 rounded-lg border border-white/10 px-3 py-2 text-xs"
                    >
                      Copy identity ID
                    </button>
                  </div>
                )}
                <input
                  value={candidateId}
                  onChange={(e) => {
                    setCandidateId(e.target.value);
                    setIncludeCandidate(false);
                  }}
                  placeholder="0x… (64 hexadecimal characters)"
                  className="mt-3 w-full rounded-xl border border-white/10 bg-white/[.03] px-3 py-3 font-mono text-[10px] outline-none focus:border-mint/30"
                />
                <div className="mt-3 flex flex-wrap items-center justify-between gap-3">
                  <span className="text-[10px] text-muted">
                    {!candidateValid
                      ? "Enter a valid bytes32 identity ID"
                      : candidateLoading
                        ? "Checking IdentityRegistry…"
                        : candidate &&
                            candidateActive &&
                            String(candidateOwner).toLowerCase() ===
                              address?.toLowerCase()
                          ? `Verified: ${candidateName || "Registered passkey"}`
                          : "Identity inactive, missing, or not owned by this wallet"}
                  </span>
                  <button
                    disabled={
                      !candidateValid ||
                      candidateLoading ||
                      !candidate ||
                      !candidateActive ||
                      String(candidateOwner).toLowerCase() !==
                        address?.toLowerCase() ||
                      auths.some(
                        (a) =>
                          String(a.identityId).toLowerCase() ===
                          candidateId.trim().toLowerCase(),
                      )
                    }
                    onClick={() => setIncludeCandidate((v) => !v)}
                    className="rounded-xl border border-mint/20 bg-mint/5 px-4 py-2.5 text-xs text-mint disabled:opacity-40"
                  >
                    {includeCandidate
                      ? "Remove from proposal"
                      : "Include passkey"}
                  </button>
                </div>
                {includeCandidate && (
                  <p className="mt-2 text-xs text-mint">
                    This registered passkey will be included in the proposed
                    policy.
                  </p>
                )}
              </div>
            </div>
          </section>
          <aside className="space-y-3">
            <div className="glass rounded-3xl p-7">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-[10px] uppercase tracking-[.18em] text-muted">
                    Risk posture
                  </p>
                  <p className="mt-1 text-3xl font-semibold">
                    {x?.hasPending ? `${x.pendingRiskScore}/100` : "—"}
                  </p>
                </div>
                <ShieldAlert
                  className={
                    x?.pendingRiskScore >= 60 ? "text-warn" : "text-mint"
                  }
                />
              </div>
              {x?.hasPending ? (
                <>
                  <div className="mt-5 h-2 overflow-hidden rounded-full bg-white/5">
                    <div
                      className={`h-full ${x.pendingRiskScore >= 60 ? "bg-warn" : "bg-mint"}`}
                      style={{ width: `${x.pendingRiskScore}%` }}
                    />
                  </div>
                  <p className="mt-3 text-xs leading-5 text-muted">
                    {x.pendingRiskScore >= 60
                      ? "High-risk change. Extra confirmation is required before activation."
                      : "The current proposal is below the high-risk threshold."}
                  </p>
                </>
              ) : (
                <p className="mt-3 text-xs leading-5 text-muted">
                  Risk is computed by the contract when you submit a proposal.
                </p>
              )}
            </div>
            <div className="glass rounded-3xl p-7">
              <div className="flex items-center justify-between">
                <p className="text-sm font-semibold">Known device pattern</p>
                <button
                  onClick={() => setKnown((v) => !v)}
                  className={`relative h-6 w-11 rounded-full transition ${known ? "bg-mint" : "bg-white/10"}`}
                >
                  <span
                    className={`absolute top-1 h-4 w-4 rounded-full bg-void transition ${known ? "left-6" : "left-1"}`}
                  />
                </button>
              </div>
              <p className="mt-2 text-xs leading-5 text-muted">
                Tell the risk engine whether this looks like an expected device
                pattern. The value is written into the proposal calculation — it
                is not a decorative toggle.
              </p>
            </div>
            {!pending && (
              <button
                disabled={busy || remaining.length === 0}
                onClick={stage}
                className="flex w-full items-center justify-center gap-2 rounded-2xl bg-mint px-5 py-4 text-sm font-semibold text-void disabled:opacity-40"
              >
                {busy ? (
                  <Loader2 size={16} className="animate-spin" />
                ) : (
                  <RefreshCw size={16} />
                )}{" "}
                Stage this policy change
              </button>
            )}
            {pending && (
              <div className="glass rounded-3xl p-7">
                <div className="flex items-center gap-2 text-warn">
                  <TimerReset size={17} />
                  <p className="text-sm font-semibold">
                    24-hour contest window
                  </p>
                </div>
                <p className="mt-3 text-xs leading-5 text-muted">
                  The proposal was recorded at{" "}
                  {new Date(
                    Number(x.pendingProposedAt) * 1000,
                  ).toLocaleString()}
                  . Activation unlocks after the delay.
                </p>
                <div className="mt-5 h-2 overflow-hidden rounded-full bg-white/5">
                  <div
                    className="h-full bg-warn transition-all"
                    style={{ width: `${pendingPct}%` }}
                  />
                </div>
                <div className="mt-5 grid gap-2 sm:grid-cols-3">
                  <button
                    disabled={busy}
                    onClick={contest}
                    className="rounded-xl border border-danger/20 bg-danger/5 px-3 py-3 text-xs text-danger"
                  >
                    Contest
                  </button>
                  {x.pendingRequiresExtraConfirmation &&
                  !x.pendingExtraConfirmationGiven ? (
                    <button
                      disabled={busy}
                      onClick={confirm}
                      className="rounded-xl border border-warn/20 bg-warn/5 px-3 py-3 text-xs text-warn"
                    >
                      Extra confirm
                    </button>
                  ) : (
                    <span className="grid place-items-center rounded-xl border border-mint/10 bg-mint/5 px-3 py-3 text-center text-[10px] text-mint">
                      {x.pendingRequiresExtraConfirmation
                        ? "Confirmation given"
                        : "No extra confirmation"}
                    </span>
                  )}
                  <button
                    disabled={busy}
                    onClick={activate}
                    className="rounded-xl border border-mint/20 bg-mint/5 px-3 py-3 text-xs text-mint"
                  >
                    Activate
                  </button>
                </div>
              </div>
            )}
          </aside>
        </div>
        {msg && (
          <div className="mt-5 flex items-start gap-3 rounded-2xl border border-white/8 bg-white/[.025] p-4 text-xs leading-5 text-muted">
            <OctagonAlert size={15} className="mt-0.5 shrink-0 text-mint" />
            {msg}
          </div>
        )}
        <div className="mt-10 grid gap-3 sm:grid-cols-3">
          <Mini
            icon={Clock3}
            title="24h delay"
            text="Reconfiguration is never instant."
          />
          <Mini
            icon={ShieldAlert}
            title="Risk score"
            text="The contract scores context, not UI intent."
          />
          <Mini
            icon={TimerReset}
            title="Contestable"
            text="A valid passkey can kill a pending change."
          />
        </div>
      </main>
      <TxToast hash={tx} onClose={() => setTx(undefined)} />
    </>
  );
}
function Mini({
  icon: Icon,
  title,
  text,
}: {
  icon: any;
