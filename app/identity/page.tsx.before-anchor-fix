"use client";
import {useEffect,useState} from "react";import Link from "next/link";import {useAccount,useReadContract,useWriteContract,useWaitForTransactionReceipt} from "wagmi";import {keccak256,concatHex} from "viem";import {Fingerprint,Loader2,ArrowRight,ShieldCheck,KeyRound,Smartphone,CheckCircle2} from "lucide-react";import Nav from "@/components/Nav";import Background from "@/components/Background";import SectionTitle from "@/components/SectionTitle";import ConnectCard from "@/components/ConnectCard";import OnChainPill from "@/components/OnChainPill";import TxToast from "@/components/TxToast";import {CONTRACTS,AUTH_CONFIG_MANAGER,IDENTITY_REGISTRY,shortAddress} from "@/lib/anchor";import {createPasskey,isWebAuthnAvailable,registrationChallenge,signWithPasskey,saveCredential} from "@/lib/webauthn";
export default function Identity(){const{address,isConnected}=useAccount();const{data:s,refetch}=useReadContract({address:CONTRACTS.anchorViews.address,abi:CONTRACTS.anchorViews.abi,functionName:"getAccountSummary",args:address?[address]:undefined,query:{enabled:!!address,refetchInterval:5000}});const{writeContractAsync}=useWriteContract();const[busy,setBusy]=useState(false);const[msg,setMsg]=useState('');const[tx,setTx]=useState<string>();const[registrationTx,setRegistrationTx]=useState<string>();const[name,setName]=useState('My Anchor Passkey');const[identityId,setIdentityId]=useState<string>();const x=s as any;const pendingKey=address?`anchor:pending-identity:${address.toLowerCase()}`:undefined;const{isSuccess:txConfirmed}=useWaitForTransactionReceipt({hash:registrationTx as `0x${string}`|undefined});useEffect(()=>{if(!pendingKey)return;try{const raw=localStorage.getItem(pendingKey);if(raw){const saved=JSON.parse(raw);if(typeof saved.id==='string')setIdentityId(saved.id);if(typeof saved.tx==='string'){setRegistrationTx(saved.tx);setTx(saved.tx)}}}catch{/* Ignore invalid local recovery data; chain state remains authoritative. */}},[pendingKey]);const register=async()=>{if(!address)return;if(!isWebAuthnAvailable())return setMsg('WebAuthn is unavailable. Use a modern browser in HTTPS or localhost.');setBusy(true);setMsg('');try{const challenge=await registrationChallenge(address);const created=await createPasskey(challenge,address);const proof=await signWithPasskey(created.credentialId,challenge);const hash=await writeContractAsync({address:IDENTITY_REGISTRY,abi:CONTRACTS.identityRegistry.abi,functionName:'registerWithPasskey',args:[created.pubKeyX,created.pubKeyY,proof,name]});const id=keccak256(concatHex([created.pubKeyX,created.pubKeyY]));saveCredential(id,created.credentialId);setIdentityId(id);setRegistrationTx(hash);setTx(hash);if(pendingKey)localStorage.setItem(pendingKey,JSON.stringify({id,tx:hash}));setMsg('Passkey registration submitted. The initialize action will unlock after Monad confirms this transaction.');await refetch()}catch(e){setMsg(e instanceof Error?e.message:'Passkey registration failed')}finally{setBusy(false)}};const initialize=async()=>{if(!identityId||!address)return;setBusy(true);try{const hash=await writeContractAsync({address:AUTH_CONFIG_MANAGER,abi:CONTRACTS.authConfigManager.abi,functionName:'initializeConfig',args:[[{id:1,scheme:1,identityId: identityId as `0x${string}`}],[1],1,[1],1]});setTx(hash);if(pendingKey)localStorage.removeItem(pendingKey);setMsg('Anchor policy initialization submitted. Your address is now armed.');await refetch()}catch(e){setMsg(e instanceof Error?e.message:'Initialization failed')}finally{setBusy(false)}};if(!isConnected)return <><Background/><Nav/><main className="mx-auto max-w-7xl px-4 pb-24 pt-32 sm:px-6 lg:px-8"><SectionTitle eyebrow="Identity" title="Replace the seed phrase with a device-bound credential." body="Anchor uses a real WebAuthn P-256 passkey. The browser creates the private key; the contract verifies proof of possession."/><div className="mt-12"><ConnectCard/></div></main></>;return <><Background/><Nav/><main className="mx-auto max-w-7xl px-4 pb-24 pt-32 sm:px-6 lg:px-8"><SectionTitle eyebrow="Identity / passkey" title="Your device becomes the key." body="Anchor uses a real WebAuthn P-256 passkey. The browser creates the private key; the contract verifies proof of possession."/><div className="mt-12 grid gap-5 lg:grid-cols-[1fr_.8fr]"><div className="glass scanline rounded-3xl p-7 sm:p-9"><div className="flex items-center justify-between"><div className="grid h-12 w-12 place-items-center rounded-2xl border border-mint/20 bg-mint/5 text-mint"><Fingerprint size={23}/></div><OnChainPill text={x?.authenticators?.length?'Identity active':'Identity not registered'}/></div><h2 className="display mt-8 text-3xl font-semibold">Register a passkey</h2><p className="mt-3 max-w-xl text-sm leading-6 text-muted">Before the browser prompt, Anchor tells you what is happening. After it returns, the signature is sent to the deployed IdentityRegistry for verification.</p><label className="mt-7 block text-xs text-muted">Passkey display name<input value={name} onChange={e=>setName(e.target.value)} className="mt-2 w-full rounded-2xl border border-white/10 bg-white/[.03] px-4 py-3 text-sm outline-none focus:border-mint/30"/></label><button disabled={busy} onClick={register} className="mt-5 inline-flex items-center gap-2 rounded-full bg-mint px-5 py-3 text-sm font-semibold text-void disabled:opacity-50">{busy?<Loader2 className="animate-spin" size={16}/>:<Fingerprint size={16}/>} {x?.authenticators?.length?'Register another device':'Create passkey'}</button>{msg&&<p className="mt-4 rounded-2xl border border-white/8 bg-white/[.025] p-4 text-xs leading-5 text-muted">{msg}</p>}{identityId&&txConfirmed&&!x?.authenticators?.length&&<button disabled={busy} onClick={initialize} className="mt-3 inline-flex items-center gap-2 rounded-full border border-mint/20 bg-mint/5 px-5 py-3 text-sm text-mint">Initialize Anchor policy <ArrowRight size={15}/></button>}</div><div className="space-y-3"><Info icon={Smartphone} title="Private key stays with the authenticator" text="Face ID, fingerprint, PIN or a security key unlocks the credential. The secret never becomes a seed phrase in Anchor."/><Info icon={ShieldCheck} title="Proof is checked on-chain" text="IdentityRegistry verifies the WebAuthn proof against the registered P-256 public key."/><Info icon={KeyRound} title="Rotation without migration" text="Once the account is armed, policy changes can replace authenticators while the account address stays fixed."/></div></div>{x?.authenticators?.length>0&&<div className="mt-10"><div className="mb-4 flex items-center justify-between"><h2 className="display text-2xl font-semibold">Registered authenticators</h2><Link href="/policy" className="text-xs text-mint">Manage policy →</Link></div><div className="grid gap-3 sm:grid-cols-2">{x.authenticators.map((a:any)=><div key={a.id} className="glass rounded-2xl p-5"><div className="flex items-center justify-between"><span className="text-xs text-muted">Authenticator #{a.id}</span><CheckCircle2 size={16} className={a.active?'text-mint':'text-danger'}/></div><p className="mt-4 font-medium">{a.displayName||'Unnamed passkey'}</p><p className="mono mt-2 text-[10px] text-muted break-all">{a.identityId}</p></div>)}</div></div>}</main><TxToast hash={tx} onClose={()=>setTx(undefined)}/></>}
function Info({icon:Icon,title,text}:{icon:any;title:string;text:string}){return <div className="glass rounded-3xl p-6"><Icon size={18} className="text-mint"/><p className="mt-6 text-sm font-semibold">{title}</p><p className="mt-2 text-xs leading-5 text-muted">{text}</p></div>}
